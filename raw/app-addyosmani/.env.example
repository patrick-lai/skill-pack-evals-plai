# Optional. When unset, the server writes a random secret to data/session-secret.
SESSION_SECRET=

# API listen address. The Vite client proxies /api here.
PORT=43124
HOST=0.0.0.0

# Browser origin allowed to call the API with cookies, in addition to local hosts.
CLIENT_ORIGIN=http://127.0.0.1:43123

# SQLite file created on first start.
DATABASE_PATH=data/board.sqlite
