{
  "name": "tidy-intro",
  "private": true,
  "version": "1.0.0",
  "description": "A 14-second 1080p intro for Tidy, a fictional task app, rendered with Remotion.",
  "scripts": {
    "dev": "remotion studio --port 43219",
    "render": "remotion render src/index.ts TidyIntro renders/tidy-intro.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts TidyIntro",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
