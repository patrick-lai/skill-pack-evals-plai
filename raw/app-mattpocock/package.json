{
  "name": "quay",
  "private": true,
  "version": "1.0.0",
  "description": "Quay is a shared team task board.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm run start -w server\" \"npm run start -w client\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
